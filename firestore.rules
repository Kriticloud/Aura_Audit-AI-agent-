rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(resourceData) {
      return isSignedIn() && resourceData.userId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Audits ---
    match /audits/{auditId} {
      allow read, list: if isOwner(resource.data);
      allow create: if isSignedIn() 
        && isValidId(auditId)
        && request.resource.data.userId == request.auth.uid
        && isValidAudit(request.resource.data);
      allow update: if isOwner(resource.data)
        && request.resource.data.userId == resource.data.userId
        && isValidAudit(request.resource.data)
        && (
          // Allow updating status and analysis
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'analysis', 'scores', 'recommendations', 'redesignVision', 'outreach', 'screenshotUrl', 'mobileScreenshotUrl', 'mockupUrl'])
        );
      allow delete: if isOwner(resource.data);
    }

    function isValidAudit(data) {
      return data.url is string && data.url.size() <= 2048
        && data.status in ['pending', 'processing', 'completed', 'failed']
        && data.userId == request.auth.uid;
    }

    // --- Leads ---
    match /leads/{leadId} {
      allow read, list: if isOwner(resource.data);
      allow create: if isSignedIn()
        && isValidId(leadId)
        && request.resource.data.userId == request.auth.uid
        && isValidLead(request.resource.data);
      allow update: if isOwner(resource.data)
        && request.resource.data.userId == resource.data.userId
        && isValidLead(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']);
      allow delete: if isOwner(resource.data);
    }

    function isValidLead(data) {
      return data.website is string && data.website.size() <= 2048
        && data.status in ['new', 'contacted', 'interested', 'converted', 'rejected']
        && data.userId == request.auth.uid;
    }
  }
}
