{
  "entities": {
    "Audit": {
      "title": "Audit Report",
      "description": "A comprehensive website audit report generated by AI.",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "The URL of the website audited." },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "scores": {
          "type": "object",
          "properties": {
            "uiux": { "type": "number" },
            "branding": { "type": "number" },
            "mobile": { "type": "number" },
            "seo": { "type": "number" },
            "trust": { "type": "number" },
            "conversion": { "type": "number" },
            "overall": { "type": "number" },
            "urgency": { "type": "number" },
            "leadQuality": { "type": "number" },
            "investmentPotential": { "type": "number" }
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "uiux": { "type": "string" },
            "branding": { "type": "string" },
            "mobile": { "type": "string" },
            "conversion": { "type": "string" },
            "performance": { "type": "string" },
            "seo": { "type": "string" },
            "trust": { "type": "string" }
          }
        },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "redesignVision": {
          "type": "object",
          "properties": {
            "direction": { "type": "string" },
            "colors": { "type": "array", "items": { "type": "string" } },
            "typography": { "type": "string" },
            "animations": { "type": "string" }
          }
        },
        "outreach": {
          "type": "object",
          "properties": {
            "email": { "type": "string" },
            "whatsapp": { "type": "string" },
            "linkedin": { "type": "string" },
            "summary": { "type": "string" },
            "missedOpportunity": { "type": "string" }
          }
        },
        "screenshotUrl": { "type": "string" },
        "mobileScreenshotUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["url", "status", "userId", "createdAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "A potential client identified through auditing.",
      "type": "object",
      "properties": {
        "website": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "interested", "converted", "rejected"] },
        "auditId": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["website", "status", "userId"]
    }
  },
  "firestore": {
    "audits": {
      "schema": "Audit",
      "description": "Stores generated website audit reports."
    },
    "leads": {
      "schema": "Lead",
      "description": "Stores lead information and outreach status."
    }
  }
}
